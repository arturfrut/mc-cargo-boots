---
// docs/specs/005-productos-listado.md — primero se elige el sistema
// (Standard / Semi-custom / Custom); los modelos viven en /productos/sistema/[sistema].
import Layout from "../../layouts/Layout.astro";
import { SISTEMAS, modelosDeSistema } from "../../lib/sistemas";
---

<Layout title="Productos" description="Botas MC Cargo Boots para patín carrera: sistemas Standard, Semi-custom y Custom.">
  <section class="listado">
    <div class="listado-inner">
      <h1>Productos</h1>
      <p class="intro">Elegí primero el sistema de fabricación y después el modelo.</p>

      <div class="grid">
        {
          SISTEMAS.map((sistema) => {
            const cantidad = sistema.tipoAjuste ? modelosDeSistema(sistema).length : sistema.modelosPendientes.length;
            return (
              <a class="card" href={`/productos/sistema/${sistema.id}`}>
                <h2>{sistema.nombre}</h2>
                <p class="card-desc">{sistema.descripcion}</p>
                <span class="card-count">{cantidad} modelos</span>
                <span class="card-cta">Ver modelos</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .listado {
    padding: 3.5rem 1.25rem 5rem;
  }

  .listado-inner {
    max-width: 75rem;
    margin: 0 auto;
  }

  .intro {
    margin-top: 0.75rem;
    color: var(--color-text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text-primary);
    border: 1px solid var(--accent-border); /* divisor turquesa fino, acento no relleno */
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  .card h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .card-desc {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .card-count {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .card-cta {
    margin-top: 1.25rem;
    align-self: flex-start;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
  }
</style>
