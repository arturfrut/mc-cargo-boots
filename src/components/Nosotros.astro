---
// docs/specs/003-nosotros.md
import { Image } from "astro:assets";
import hormaMolde from "../assets/nosotros/horma-molde-yeso.jpg";
import patinadoraPodio from "../assets/nosotros/patinadora-podio-pista.jpg";
import llegadaBerlin from "../assets/nosotros/llegada-maraton-berlin.jpg";
import patinadorBelgica from "../assets/nosotros/patinador-belgica-ruta.jpg";
import patinadorColombia from "../assets/nosotros/patinador-colombia-pista.jpg";
import collageTaller from "../assets/nosotros/collage-taller.jpg";

const valores = ["Técnica", "Personalización", "Seriedad", "Transparencia", "Artesanía"];

// Set final de fotos entregado por el cliente (reemplaza el stock temporal
// que había antes) — ver "Abierto/pendiente" de la spec, ahora resuelto.
const carousel = [
  { img: hormaMolde, alt: "Horma de yeso del molde de un pie, trabajo artesanal de MC Cargo" },
  { img: patinadoraPodio, alt: "Patinadora festejando en pista cubierta" },
  { img: llegadaBerlin, alt: "Llegada de dos patinadores en el Maratón de Berlín" },
  { img: patinadorBelgica, alt: "Patinador con la camiseta de Bélgica festejando en ruta" },
  { img: patinadorColombia, alt: "Patinador de Colombia señalando en pista" },
  { img: collageTaller, alt: "Collage del equipo trabajando en el taller: puliendo, armando hormas, cortando materiales" },
];
---

<section id="nosotros" class="nosotros">
  <div class="nosotros-inner">
    <h2>Sobre nosotros</h2>

    <div class="nosotros-copy">
      <p>
        Fábrica familiar argentina de botas para patín carrera, con más de 30 años de experiencia
        desde 1990. Liderada por <strong>Sergio Mc Cargo</strong>, ex-patinador de la selección
        nacional y medallista en mundiales, técnico mecánico especialista en estructuras de fibra
        de carbono y PRFC.
      </p>
      <p>
        Nuestro diferencial es combinar ese conocimiento técnico-mecánico con la experiencia
        deportiva competitiva, en cada bota que sale del taller.
      </p>
    </div>

    <ul class="valores">
      {valores.map((valor) => <li>{valor}</li>)}
    </ul>

    <div class="carousel" role="group" aria-label="Fotos de MC Cargo Boots: taller y patinadores">
      {
        carousel.map((item) => (
          <figure class="carousel-item">
            <div class="carousel-media">
              <Image src={item.img} alt={item.alt} widths={[320, 480, 640]} sizes="(min-width: 48rem) 16rem, 80vw" quality={65} />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .nosotros {
    padding: 4.5rem 1.25rem;
    border-top: 1px solid var(--divider-subtle);
  }

  .nosotros-inner {
    max-width: 60rem;
    margin: 0 auto;
  }

  .nosotros-copy {
    max-width: 42rem;
    margin-top: 1.5rem;
  }

  .nosotros-copy p {
    color: var(--color-text-secondary);
  }

  .nosotros-copy p + p {
    margin-top: 1rem;
  }

  .nosotros-copy strong {
    color: var(--color-text-primary);
    font-weight: 600; /* Poppins SemiBold, ver brand-guide §3 */
  }

  .valores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .valores li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }

  .carousel {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .carousel-item {
    flex: 0 0 min(16rem, 80vw);
    margin: 0;
    scroll-snap-align: start;
  }

  .carousel-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .carousel-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
