---
// docs/specs/003-nosotros.md
import { Image } from "astro:assets";
import { stockCreditLabel } from "../lib/constants";
import berlinMarathon from "../assets/stock/nosotros-berlin-marathon.jpg";
import berlin2017 from "../assets/stock/nosotros-berlin-2017.jpg";
import ludwigsfelde2005 from "../assets/stock/nosotros-ludwigsfelde-2005.jpg";
import boysFinal42 from "../assets/stock/nosotros-boys-final-42.jpg";

const valores = ["Técnica", "Personalización", "Seriedad", "Transparencia", "Artesanía"];

// Fotos de stock temporales (no son de MC Cargo) — el carrusel real usa fotos
// en alta resolución que el cliente todavía no entregó (ver
// "Abierto/pendiente" de la spec). Créditos completos en
// docs/credits/fotos-stock.md.
const carousel = [
  { img: berlinMarathon, credit: "nosotros-berlin-marathon" as const, alt: "Maratón de patinadores, Berlín 2010" },
  { img: berlin2017, credit: "nosotros-berlin-2017" as const, alt: "Patinadores de carrera en las calles de Berlín, 2017" },
  { img: ludwigsfelde2005, credit: "nosotros-ludwigsfelde-2005" as const, alt: "Maratón de patín carrera, Ludwigsfelde 2005" },
  { img: boysFinal42, credit: "nosotros-boys-final-42" as const, alt: "Final de patín carrera, Juegos Olímpicos de la Juventud 2018" },
];
---

<section id="nosotros" class="nosotros">
  <div class="nosotros-inner">
    <h2>Sobre nosotros</h2>

    <div class="nosotros-copy">
      <p>
        Fábrica familiar argentina de botas para patín carrera, con más de 30 años de experiencia
        desde 1990. Liderada por <strong>Sergio Mc Cargo</strong>, ex-patinador de la selección
        nacional y medallista en mundiales, técnico mecánico especialista en estructuras de fibra
        de carbono y PRFC.
      </p>
      <p>
        Nuestro diferencial es combinar ese conocimiento técnico-mecánico con la experiencia
        deportiva competitiva, en cada bota que sale del taller.
      </p>
    </div>

    <ul class="valores">
      {valores.map((valor) => <li>{valor}</li>)}
    </ul>

    <div class="carousel" role="group" aria-label="Fotos de patín carrera (stock temporal, no son de MC Cargo)">
      {
        carousel.map((item) => (
          <figure class="carousel-item">
            <div class="carousel-media">
              <Image src={item.img} alt={item.alt} widths={[320, 480, 640]} sizes="(min-width: 48rem) 16rem, 80vw" quality={65} />
            </div>
            <figcaption>{stockCreditLabel(item.credit)}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .nosotros {
    padding: 4.5rem 1.25rem;
    border-top: 1px solid rgba(176, 176, 176, 0.15);
  }

  .nosotros-inner {
    max-width: 60rem;
    margin: 0 auto;
  }

  .nosotros-copy {
    max-width: 42rem;
    margin-top: 1.5rem;
  }

  .nosotros-copy p {
    color: var(--color-text-secondary);
  }

  .nosotros-copy p + p {
    margin-top: 1rem;
  }

  .nosotros-copy strong {
    color: var(--color-text-primary);
    font-weight: 600; /* Poppins SemiBold, ver brand-guide §3 */
  }

  .valores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .valores li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
  }

  .carousel {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }

  .carousel-item {
    flex: 0 0 min(16rem, 80vw);
    margin: 0;
    scroll-snap-align: start;
  }

  .carousel-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .carousel-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel-item figcaption {
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }
</style>
