---
import { WHATSAPP_GENERIC_MESSAGE, whatsappHref } from "../lib/constants";
import { DEFAULT_LOCALE, NAV_ITEMS_BY_LOCALE, isLocale, navLabel, t } from "../i18n/ui";
import RegionSelector from "./RegionSelector.astro";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const navItems = NAV_ITEMS_BY_LOCALE[locale];
const baseMessage = WHATSAPP_GENERIC_MESSAGE[locale];
---

<header class="site-header">
  <div class="site-header-inner">
    <a href={locale === "en" ? "/en" : "/"} class="logo" aria-label={t(locale, "logo.aria")}>
      <!--
        Placeholder de texto: el manual de marca prohíbe recrear el logo
        (símbolo + isotipo) desde cero — assets SVG/PNG oficiales pendientes
        de pedir al cliente (docs/brand/brand-guide.md §4). Reemplazar por
        <img> con el SVG oficial (mín. 120px de ancho) cuando estén.
      -->
      <span class="logo-word">MC <span class="accent">CARGO</span></span>
      <span class="logo-sub">BOOTS</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Abrir menú"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Navegación principal">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={locale === "en" ? `/en${item.href}` : item.href}>{navLabel(locale, item.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <RegionSelector />
      <a
        class="whatsapp-cta"
        href={whatsappHref(baseMessage)}
        data-whatsapp-msg={baseMessage}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(locale, "whatsapp.cta.aria")}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.51 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.55 3.7-8.24 8.26-8.24 2.21 0 4.28.86 5.84 2.42a8.19 8.19 0 0 1 2.42 5.83c0 4.55-3.71 8.24-8.27 8.24Zm4.52-6.17c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.96-.15.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.47-.01-.16 0-.43.06-.65.31-.23.25-.85.83-.85 2.02s.87 2.35.99 2.51c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.46-.6 1.67-1.18.2-.58.2-1.08.14-1.18-.06-.1-.22-.16-.47-.28Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--color-bg-primary);
    border-bottom: 1px solid rgba(176, 176, 176, 0.2); /* línea divisoria, único acento no-turquesa */
  }

  .site-header-inner {
    max-width: 75rem;
    margin: 0 auto;
    height: var(--header-height);
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
    margin-right: auto;
  }

  .logo-word {
    font-family: var(--font-h1);
    font-size: 1.15rem;
    letter-spacing: 0.03em;
    color: var(--color-text-primary);
  }

  .logo-sub {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    color: var(--color-text-secondary);
  }

  .site-nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .whatsapp-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg-primary);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
  }

  @media (max-width: 56rem) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg-primary);
      border-bottom: 1px solid rgba(176, 176, 176, 0.2);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s ease;
    }

    .site-nav.is-open {
      max-height: 20rem;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1rem;
    }

    .site-nav li {
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(176, 176, 176, 0.1);
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    nav?.classList.toggle("is-open", !expanded);
  });
</script>
