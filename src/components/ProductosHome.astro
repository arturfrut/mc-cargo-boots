---
// docs/specs/004-productos-home.md — la home muestra los 3 sistemas (Standard,
// Semi-custom, Custom); cada uno lleva a su página con los modelos.
import { SISTEMAS } from "../lib/sistemas";
---

<section id="productos" class="productos">
  <div class="productos-inner">
    <h2>Productos</h2>

    <div class="grid">
      {
        SISTEMAS.map((sistema) => (
          <article class="card">
            <h3>{sistema.nombre}</h3>
            <p class="card-desc">{sistema.descripcion}</p>
            <a class="card-cta" href={`/productos/sistema/${sistema.id}`}>
              Ver modelos
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .productos {
    padding: 4.5rem 1.25rem;
    border-top: 1px solid var(--divider-subtle);
  }

  .productos-inner {
    max-width: 75rem;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--accent-border); /* divisor turquesa fino, acento no relleno */
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .card h3 {
    margin: 0.35rem 0 0;
    font-family: var(--font-body);
    font-weight: 600; /* Poppins SemiBold */
    font-size: 1.15rem;
  }

  .card-desc {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .card-cta {
    margin-top: 1.25rem;
    align-self: flex-start;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
  }

</style>
