---
// Grupo de opción única. docs/specs/007-formularios.md: Sexo/Uso/Contextura/Modelo, etc.
// con las opciones exactas del original.
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  legend: string;
  options: Option[];
  required?: boolean;
  helpText?: string;
}

const { name, legend, options, required = true, helpText } = Astro.props;
---

<fieldset class="field">
  <legend>
    {legend}
    {required && <span class="req" aria-hidden="true">*</span>}
  </legend>
  <div class="options">
    {
      options.map((option, i) => (
        <label class="option">
          <input type="radio" name={name} value={option.value} required={required && i === 0} />
          <span>{option.label}</span>
        </label>
      ))
    }
  </div>
  {helpText && <p class="help">{helpText}</p>}
</fieldset>

<style>
  .field {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  legend {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0;
  }

  .req {
    color: var(--color-accent);
    margin-left: 0.15rem;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--divider-strong);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .option:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--accent-tint-weak);
  }

  .option:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .option input {
    accent-color: var(--color-accent);
  }

  .help {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>
