---
// Selector de modelo como tarjetas con foto de producto (radio-as-card).
// docs/catalog/formularios-relevamiento-custom.md §1b/§2/§7c.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ModelOption {
  value: string;
  label: string;
  description?: string;
  image: ImageMetadata;
}

interface Props {
  name: string;
  legend: string;
  options: ModelOption[];
  required?: boolean;
}

const { name, legend, options, required = true } = Astro.props;
---

<fieldset class="field">
  <legend>
    {legend}
    {required && <span class="req" aria-hidden="true">*</span>}
  </legend>
  <div class="cards">
    {
      options.map((option, i) => (
        <label class="card">
          <input type="radio" name={name} value={option.value} required={required && i === 0} />
          <Image src={option.image} alt={option.label} widths={[280, 560]} sizes="(min-width: 48rem) 14rem, 45vw" />
          <span class="card-label">{option.label}</span>
          {option.description && <span class="card-desc">{option.description}</span>}
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .field {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  legend {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0;
  }

  .req {
    color: var(--color-accent);
    margin-left: 0.15rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--divider-strong);
    border-radius: 0.5rem;
    padding: 0.75rem;
    cursor: pointer;
  }

  .card:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--accent-tint-weak);
  }

  .card:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .card input {
    align-self: flex-start;
    accent-color: var(--color-accent);
  }

  .card :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.35rem;
  }

  .card-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .card-desc {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>
